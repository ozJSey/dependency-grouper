{
  "name": "@ozjsey/dependency-grouper",
  "version": "0.3.8",
  "description": "Group and reuse dependency sets across monorepo projects (pnpm, npm, yarn)",
  "main": "dist/index.min.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dependency-grouper": "dist/cli.min.js",
    "dep-grouper": "dist/cli.min.js"
  },
  "files": [
    "dist/*.min.js",
    "dist/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node esbuild.config.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "npm run build && node test/test.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozjsey/dependency-grouper.git"
  },
  "bugs": {
    "url": "https://github.com/ozjsey/dependency-grouper/issues"
  },
  "homepage": "https://github.com/ozjsey/dependency-grouper#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "pnpm",
    "npm",
    "yarn",
    "dependencies",
    "workspace",
    "workspaces",
    "monorepo",
    "package-manager",
    "dependency-management"
  ],
  "author": "ozjsey",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "sort-package-json": "^2.10.0",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
